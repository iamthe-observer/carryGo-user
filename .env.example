# CarryGo Environment Configuration
# Copy this file to .env and fill in your Supabase project keys.
# If left empty, CarryGo runs smoothly in Demo Fallback Mode with local persistence.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional: Google Maps API key for production builds (Expo Go works without this)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
